<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CommunityGuard.Maui.ViewModels"
             xmlns:dtos="clr-namespace:CommunityGuard.Shared.Dtos;assembly=CommunityGuard.Shared"
             x:Class="CommunityGuard.Maui.Views.IncidentsPage"
             x:DataType="vm:IncidentsViewModel"
             Title="Incidents">

    <!-- Split Screen Layout: 400px list, 1px divider, flexible details -->
    <Grid ColumnDefinitions="400, 1, *" BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">

        <!-- ========================================== -->
        <!-- LEFT PANE: The Incident List               -->
        <!-- ========================================== -->
        <Grid Grid.Column="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadIncidentsCommand}">

                <CollectionView ItemsSource="{Binding Incidents}" 
                                SelectionMode="Single"
                                SelectionChanged="OnIncidentSelected">

                    <!-- UX POLISH: Empty State -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                            <Label Text="No incidents found." FontSize="18" TextColor="Gray" />
                            <Label Text="You are all clear!" FontSize="14" TextColor="Gray" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <!-- List Item Template -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dtos:IncidentDto">
                            <VerticalStackLayout Padding="15,10">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Sector, StringFormat='Sector: {0}'}" FontSize="12" TextColor="Gray" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" Margin="0,10,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- ========================================== -->
        <!-- RIGHT PANE: The Incident Details           -->
        <!-- ========================================== -->
        <Grid Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F9F9F9, Dark=#121212}">

            <!-- Placeholder when nothing is selected -->
            <Label Text="Select an incident from the list to view details." 
                   HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" FontSize="16"
                   IsVisible="{Binding SelectedIncidentDetail, Converter={StaticResource IsNullConverter}}" />

            <!-- The Details View (Visible when an item is selected) -->
            <ScrollView IsVisible="{Binding SelectedIncidentDetail, Converter={StaticResource IsNotNullConverter}}">

                <!-- CRITICAL FIX: x:DataType points to IncidentDetailDto so it knows where Title, Sector, etc. live -->
                <VerticalStackLayout Padding="30" Spacing="20" 
                                     BindingContext="{Binding SelectedIncidentDetail}" 
                                     x:DataType="dtos:IncidentDetailDto">

                    <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" />
                    <Label Text="{Binding Description}" FontSize="16" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Grid.Column="0" Text="Sector: " FontAttributes="Bold" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Sector}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Priority: " FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Priority}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Status: " FontAttributes="Bold" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Status}" TextColor="#512BD4" FontAttributes="Bold" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />
                    <Label Text="Audit Trail" FontSize="20" FontAttributes="Bold" />

                    <!-- The History Timeline -->
                    <CollectionView ItemsSource="{Binding History}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:IncidentHistoryDto">
                                <Grid ColumnDefinitions="Auto,*" Padding="0,5">
                                    <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10" Fill="#512BD4" VerticalOptions="Start" Margin="0,5,10,0" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Status}" FontAttributes="Bold" />
                                        <Label Text="{Binding ChangedAt, StringFormat='{0:g}'}" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>