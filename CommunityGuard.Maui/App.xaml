<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CommunityGuard.Maui"
             xmlns:converters="clr-namespace:CommunityGuard.Maui.Converters"
             x:Class="CommunityGuard.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- REGISTER YOUR CONVERTERS HERE -->
            <converters:IsNullConverter x:Key="IsNullConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />

            <!-- Make sure this one is here too from Phase 8! -->
            <converters:PriorityToColorConverter x:Key="PriorityToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>